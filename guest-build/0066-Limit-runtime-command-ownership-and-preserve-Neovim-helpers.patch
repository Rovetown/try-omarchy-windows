From 63e6b125328197fa5f26cf0283e579c426c4c488 Mon Sep 17 00:00:00 2001
From: Try Omarchy <test@localhost>
Date: Mon, 14 Sep 2026 18:21:14 -0400
Subject: [PATCH] Limit runtime command ownership and preserve Neovim helpers
 on upgrade

---
 guest/scripts/register-omarchy-runtime.sh     | 19 +++-
 guest/scripts/runtime-ownership.install       | 45 +++++++++
 guest/spec.json                               |  2 +-
 guest/tests/test_runtime_ownership_install.py | 83 ++++++++++++++++
 guest/tests/test_runtime_package.py           | 99 +++++++++++++++++++
 5 files changed, 243 insertions(+), 5 deletions(-)
 create mode 100644 guest/scripts/runtime-ownership.install
 create mode 100644 guest/tests/test_runtime_ownership_install.py
 create mode 100644 guest/tests/test_runtime_package.py

diff --git a/guest/scripts/register-omarchy-runtime.sh b/guest/scripts/register-omarchy-runtime.sh
index 2f696b6..b82a514 100755
--- a/guest/scripts/register-omarchy-runtime.sh
+++ b/guest/scripts/register-omarchy-runtime.sh
@@ -102,11 +102,17 @@ cp -a "$root/usr/share/omarchy" "$stage/usr/share/omarchy"
 cp -a "$root/usr/share/licenses/omarchy" "$stage/usr/share/licenses/omarchy"
 
 shopt -s nullglob
-runtime_commands=("$root/usr/bin/omarchy" "$root/usr/bin"/omarchy-*)
+# Only materialized upstream command links belong to this package. Other
+# packages (for example omarchy-nvim) also install /usr/bin/omarchy-* helpers.
+runtime_commands=("$root/usr/share/omarchy/bin/"*)
 (( ${#runtime_commands[@]} > 1 )) || fail "staged Omarchy commands are missing"
 for command in "${runtime_commands[@]}"; do
-  [[ -f $command ]] || fail "unexpected Omarchy command: $command"
-  cp -a "$command" "$stage/usr/bin/$(basename "$command")"
+  name=$(basename "$command")
+  [[ -L $command && $(readlink "$command") == "/usr/bin/$name" ]] ||
+    fail "unexpected Omarchy command link: $command"
+  [[ -f $root/usr/bin/$name && ! -L $root/usr/bin/$name ]] ||
+    fail "missing materialized Omarchy command: $name"
+  cp -a "$root/usr/bin/$name" "$stage/usr/bin/$name"
 done
 
 # Register ownership and pacman backup semantics for the system configuration
@@ -152,6 +158,8 @@ while IFS= read -r relative; do
   printf 'backup = %s\n' "$relative" >>"$stage/.PKGINFO"
 done <"$root/usr/share/try-omarchy/runtime-config-files"
 
+cp "$(dirname "$0")/runtime-ownership.install" "$stage/.INSTALL"
+
 archive="$stage/$package_name-$package_version-any.pkg.tar.zst"
 tar \
   --sort=name \
@@ -161,7 +169,7 @@ tar \
   --numeric-owner \
   --format=gnu \
   -C "$stage" \
-  -cf - .PKGINFO usr etc |
+  -cf - .PKGINFO .INSTALL usr etc |
   zstd --force --quiet -12 --threads=1 -o "$archive"
 
 # The payload is already present and was verified against the pinned source.
@@ -180,6 +188,9 @@ query=$(pacman --config "$pacman_config" --root "$root" --dbpath "$root/var/lib/
 pacman --config "$pacman_config" --root "$root" --dbpath "$root/var/lib/pacman" -Qk "$package_name" >/dev/null ||
   fail "registered package does not own the complete staged runtime"
 
+pacman --config "$pacman_config" --root "$root" --dbpath "$root/var/lib/pacman" -Dk ||
+  fail "package database has inconsistent ownership or dependencies"
+
 # Keep an immutable package copy in the guest's local sync repository. Without
 # a matching sync record, pacman classifies this source-pinned runtime as an AUR
 # package and the upstream updater attempts to hand it to yay.
diff --git a/guest/scripts/runtime-ownership.install b/guest/scripts/runtime-ownership.install
new file mode 100644
index 0000000..d590175
--- /dev/null
+++ b/guest/scripts/runtime-ownership.install
@@ -0,0 +1,45 @@
+# Older runtime packages accidentally claimed helpers owned by omarchy-nvim.
+# libalpm removes dropped paths during upgrade even when another package owns
+# them. Retain the installed bytes before removal; never overwrite a file that
+# another package in the same transaction has already installed.
+
+pre_upgrade() {
+  local state=/var/lib/try-omarchy/runtime-ownership-recovery name path temporary
+  for name in omarchy-nvim-refresh omarchy-nvim-setup; do
+    path=/usr/bin/$name
+    pacman -Qlq try-omarchy-runtime 2>/dev/null | grep -Fx "$path" >/dev/null || continue
+    pacman -Qlq omarchy-nvim 2>/dev/null | grep -Fx "$path" >/dev/null || continue
+    [[ -e $path || -L $path ]] || continue
+    [[ -f $path || -L $path ]] || return 1
+    [[ ! -L $state ]] || return 1
+    if [[ ! -e $state ]]; then
+      install -d -m 0700 "$state" || return 1
+    fi
+    [[ -d $state && $(stat -c %u:%a "$state") == 0:700 ]] || return 1
+    temporary=$(mktemp -d "$state/.helper.XXXXXX") || return 1
+    if ! cp -a -- "$path" "$temporary/$name" || ! mv -fT -- "$temporary/$name" "$state/$name"; then
+      rm -f -- "$temporary/$name"
+      rmdir "$temporary"
+      return 1
+    fi
+    rmdir "$temporary" || return 1
+  done
+}
+
+post_upgrade() {
+  local state=/var/lib/try-omarchy/runtime-ownership-recovery name path
+  [[ -e $state || -L $state ]] || return 0
+  [[ ! -L $state && -d $state && $(stat -c %u:%a "$state") == 0:700 ]] || return 1
+  for name in omarchy-nvim-refresh omarchy-nvim-setup; do
+    path=/usr/bin/$name
+    [[ -f $state/$name || -L $state/$name ]] || continue
+    # Keep the copy if its owner is absent, for explicit recovery later.
+    pacman -Qlq omarchy-nvim 2>/dev/null | grep -Fx "$path" >/dev/null || continue
+    if [[ ! -e $path && ! -L $path ]]; then
+      cp -aT -- "$state/$name" "$path" || return 1
+    fi
+    [[ -f $path || -L $path ]] || return 1
+    rm -- "$state/$name" || return 1
+  done
+  rmdir "$state" 2>/dev/null || true
+}

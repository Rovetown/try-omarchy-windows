@@ -114,3 +114,38 @@ class StreamingFileTests(unittest.TestCase):
                 struct.pack_into('<Q', data, len(data) - 22 - 20 - 56 + 40, 1 << 40)
             with self.subTest(field=field), self.assertRaises(ValueError):
                 transfer.inspect(io.BytesIO(data))
+
+    def test_ticket_rejects_wrong_direction_and_paths(self):
+        offer = {'version': 1, 'archiveBytes': 100, 'fileBytes': 1, 'entries': 1, 'sha256': 'a' * 64}
+        ticket = {'id': 'b' * 32, 'token': 'c' * 64, 'direction': 'download', 'offer': offer}
+        self.assertTrue(transfer.valid_ticket(ticket, 'download'))
+        self.assertFalse(transfer.valid_ticket(ticket, 'upload'))
+        for name, value in [('token', '../file'), ('id', 1), ('offer', {}), ('destination', '/tmp/unwanted')]:
+            changed = dict(ticket)
+            changed[name] = value
+            self.assertFalse(transfer.valid_ticket(changed, 'download'))
+
+    def test_download_never_follows_redirect(self):
+        import http.server
+        import threading
+        class Redirect(http.server.BaseHTTPRequestHandler):
+            def do_GET(self):
+                self.send_response(302)
+                self.send_header('Location', 'http://127.0.0.1:1/private')
+                self.end_headers()
+            def log_message(self, *_):
+                pass
+        with http.server.HTTPServer(('127.0.0.1', 0), Redirect) as server:
+            worker = threading.Thread(target=server.serve_forever)
+            worker.start()
+            try:
+                offer = {'version': 1, 'archiveBytes': 100, 'fileBytes': 1, 'entries': 1, 'sha256': 'a' * 64}
+                ticket = {'id': 'b' * 32, 'token': 'c' * 64, 'direction': 'download', 'offer': offer}
+                with tempfile.TemporaryDirectory() as tmp:
+                    destination = Path(tmp) / 'Received'
+                    with self.assertRaisesRegex(ValueError, 'unavailable'):
+                        transfer.download(ticket, destination, *server.server_address)
+                    self.assertFalse(destination.exists())
+            finally:
+                server.shutdown()
+                worker.join()

From 3c212ba36236e339436b32e7bce0303302834476 Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Sat, 12 Sep 2026 12:50:01 -0400
Subject: [PATCH] Preserve native migration settings and report incomplete
 restores

---
 .../usr/local/bin/try-omarchy-export          | 54 +++++++++--
 guest/scripts/finalize-rootfs.sh              |  2 +-
 guest/tests/test_overlay_scripts.py           | 96 ++++++++++++++++++-
 guest/tests/verify.py                         |  2 +-
 4 files changed, 139 insertions(+), 15 deletions(-)

diff --git a/guest/factory-overlay/usr/local/bin/try-omarchy-export b/guest/factory-overlay/usr/local/bin/try-omarchy-export
index c2426e7..0fed736 100755
--- a/guest/factory-overlay/usr/local/bin/try-omarchy-export
+++ b/guest/factory-overlay/usr/local/bin/try-omarchy-export
@@ -63,7 +63,7 @@ for item in \
   .config/hypr .config/imv .config/kitty .config/mako .config/omarchy \
   .config/starship.toml .config/tmux .config/uwsm .config/walker \
   .config/waybar .config/wireplumber .config/xournalpp \
-  .local/share/omarchy .local/bin \
+  .local/bin \
   .bashrc .bash_profile .zshrc .zprofile .profile .gitconfig \
   .tmux.conf .vimrc .inputrc; do
   copy_home "$item"
@@ -112,8 +112,9 @@ cat >"$stage/restore.sh" <<'RESTORE'
 # It backs up anything it replaces under ~/.omarchy-restore-backup/<time>.
 set -euo pipefail
 here=$(cd "$(dirname "$0")" && pwd)
-backup="$HOME/.omarchy-restore-backup/$(date +%Y%m%d-%H%M%S)"
-mkdir -p "$backup"
+backup_root="$HOME/.omarchy-restore-backup"
+mkdir -p "$backup_root"
+backup=$(mktemp -d "$backup_root/$(date +%Y%m%d-%H%M%S).XXXXXX")
 
 # Dotfiles are replaced as units. ~/.config and ~/.local/share are merged one
 # application directory at a time, so the real install keeps configuration
@@ -126,32 +127,65 @@ entries() {
   return 0
 }
 
+incomplete=0
 echo "Restoring configuration into $HOME (backups in $backup)"
 while IFS= read -r -d '' path; do
   relative=${path#"$here/home/"}
   target="$HOME/$relative"
+  # The destination owns its Omarchy installation and display configuration.
+  [[ $relative == .local/share/omarchy ]] && continue
+  if [[ $relative == .config/hypr && ( -L $path || -L $target ) ]]; then
+    echo "Skipped linked Hyprland configuration; review it manually: $path" >&2
+    incomplete=1
+    continue
+  fi
   if [[ -e $target || -L $target ]]; then
     mkdir -p "$backup/$(dirname "$relative")"
     mv "$target" "$backup/$relative"
   fi
   mkdir -p "$(dirname "$target")"
   cp -a "$path" "$target"
+  if [[ $relative == .config/hypr ]]; then
+    for monitor in monitors.lua monitors.conf; do
+      saved="$backup/$relative/$monitor"
+      if [[ -e $saved || -L $saved ]]; then
+        cp -a --remove-destination "$saved" "$target/$monitor"
+      fi
+    done
+  fi
   echo "  restored $relative"
 done < <(entries)
 
 if [[ -s $here/packages/repo.txt ]]; then
   echo "Installing repository packages"
-  sudo pacman -S --needed --noconfirm - <"$here/packages/repo.txt" || echo "Some repository packages did not install; review packages/repo.txt" >&2
+  if ! sudo pacman -S --needed --noconfirm - <"$here/packages/repo.txt"; then
+    echo "Repository packages remain incomplete; review packages/repo.txt" >&2
+    incomplete=1
+  fi
 fi
-if [[ -s $here/packages/aur.txt ]] && command -v yay >/dev/null; then
-  echo "Installing AUR packages"
-  yay -S --needed --noconfirm - <"$here/packages/aur.txt" || echo "Some AUR packages did not install; review packages/aur.txt" >&2
+if [[ -s $here/packages/aur.txt ]]; then
+  if ! command -v yay >/dev/null; then
+    echo "AUR packages remain incomplete: yay is unavailable; review packages/aur.txt" >&2
+    incomplete=1
+  elif ! yay -S --needed --noconfirm - <"$here/packages/aur.txt"; then
+    echo "AUR packages remain incomplete; review packages/aur.txt" >&2
+    incomplete=1
+  fi
 fi
 
 theme=$(<"$here/theme")
-if [[ -n $theme ]] && command -v omarchy-theme-set >/dev/null; then
-  echo "Selecting theme $theme"
-  omarchy-theme-set "$theme" || echo "Theme $theme is not installed here; pick it from the Omarchy menu" >&2
+if [[ -n $theme ]]; then
+  if ! command -v omarchy-theme-set >/dev/null; then
+    echo "Theme restore remains incomplete: omarchy-theme-set is unavailable" >&2
+    incomplete=1
+  elif ! omarchy-theme-set "$theme"; then
+    echo "Theme $theme could not be selected; pick it from the Omarchy menu" >&2
+    incomplete=1
+  fi
+fi
+if ((incomplete)); then
+  echo "Restore incomplete. Configuration backups are in $backup; review the errors above." >&2
+  exit 1
 fi
 echo "Done. Log out and back in to load the restored configuration."
 RESTORE
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 1dda839..c55ffa4 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -126,7 +126,7 @@ kernel_release=$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '
 }
 # Bump this revision whenever compat-overlay.tar changes in a way that must be
 # applied to persistent disks created by an earlier launcher release.
-compat_revision=16
+compat_revision=17
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
 # Never let the container host's hardware autodetection remove the virtual
diff --git a/guest/tests/test_overlay_scripts.py b/guest/tests/test_overlay_scripts.py
index 91a429e..3cfbe65 100644
--- a/guest/tests/test_overlay_scripts.py
+++ b/guest/tests/test_overlay_scripts.py
@@ -244,6 +244,9 @@ class ExportTests(OverlayCase):
         self.fake("pacman", 'case "$1" in -Qqe) printf "base\\ngit\\ncowsay\\nomarchy\\nsome-aur-tool\\n";; -Qqm) printf "some-aur-tool\\n";; *) exit 1;; esac')
         (self.home / ".config/hypr").mkdir(parents=True)
         (self.home / ".config/hypr/monitors.conf").write_text("monitor=,preferred\n")
+        (self.home / ".config/hypr/bindings.lua").write_text("-- personal binding\n")
+        (self.home / ".local/share").mkdir(parents=True)
+        (self.home / ".local/share/omarchy").symlink_to("/usr/share/omarchy")
         (self.home / ".config/chromium").mkdir()
         (self.home / ".config/chromium/Cookies").write_text("secret")
         (self.home / ".config/gh").mkdir()
@@ -272,6 +275,7 @@ class ExportTests(OverlayCase):
             member = lambda name: tar.extractfile(next(m for m in tar.getmembers() if m.name.endswith("/" + name))).read().decode()
             self.assertIn("home/.config/hypr/monitors.conf", names)
             self.assertIn("home/.bashrc", names)
+            self.assertNotIn("home/.local/share/omarchy", names)
             self.assertIn("restore.sh", names)
             self.assertNotIn("home/.ssh/id_ed25519", names)
             self.assertFalse(any(".ssh" in n for n in names), names)
@@ -304,30 +308,116 @@ class ExportTests(OverlayCase):
         (real / ".config/hypr").mkdir()
         (real / ".config/hypr/monitors.conf").write_text("OLD")
         (real / ".bashrc").write_text("old")
+        (real / ".config/hypr/monitors.lua").write_text("-- native display\n")
+        (real / ".local/share").mkdir(parents=True)
+        (real / ".local/share/omarchy").symlink_to("/opt/custom-omarchy")
         for tool in ("sudo", "pacman", "yay", "omarchy-theme-set"):
             self.fake(tool, f'echo "{tool} $*" >>"{self.log}"')
         with tarfile.open(archive) as tar:
-            tar.extractall(real)
+            tar.extractall(real, filter="fully_trusted")
         restore = next(real.glob("omarchy-export-*/restore.sh"))
         result = subprocess.run(["bash", str(restore)], env=dict(self.env, HOME=str(real)), cwd=real,
                                 capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
         self.assertEqual(result.returncode, 0, result.stderr)
-        self.assertEqual((real / ".config/hypr/monitors.conf").read_text(), "monitor=,preferred\n")
+        self.assertEqual((real / ".config/hypr/monitors.conf").read_text(), "OLD")
         self.assertEqual((real / ".config/keep/k").read_text(), "keepme")
+        self.assertEqual((real / ".config/hypr/monitors.lua").read_text(), "-- native display\n")
+        self.assertEqual((real / ".config/hypr/bindings.lua").read_text(), "-- personal binding\n")
+        self.assertEqual(os.readlink(real / ".local/share/omarchy"), "/opt/custom-omarchy")
         self.assertEqual((real / ".bashrc").read_text(), "export PS1=x\n")
         backups = sorted(p.relative_to(next((real / ".omarchy-restore-backup").iterdir())).as_posix()
                          for p in (real / ".omarchy-restore-backup").rglob("*") if p.is_file())
-        self.assertEqual(backups, [".bashrc", ".config/hypr/monitors.conf"])
+        self.assertEqual(backups, [".bashrc", ".config/hypr/monitors.conf", ".config/hypr/monitors.lua"])
         calls = self.log.read_text()
         self.assertIn("sudo pacman -S --needed --noconfirm -", calls)
         self.assertIn("yay -S --needed --noconfirm -", calls)
         self.assertIn("omarchy-theme-set tokyo-night", calls)
 
 
+    def test_restore_reports_incomplete_package_or_theme_work(self) -> None:
+        archive = self.export()
+        for index, failed in enumerate(("sudo", "yay", "omarchy-theme-set")):
+            with self.subTest(failed=failed):
+                for tool in ("sudo", "yay", "omarchy-theme-set"):
+                    self.fake(tool, f'echo "{tool}" >>"{self.log}"; exit {1 if tool == failed else 0}')
+                real = self.root / f"restore-failure-{index}"
+                real.mkdir()
+                with tarfile.open(archive) as tar:
+                    tar.extractall(real, filter="fully_trusted")
+                restore = next(real.glob("omarchy-export-*/restore.sh"))
+                result = subprocess.run(["bash", str(restore)], env=dict(self.env, HOME=str(real)),
+                                        capture_output=True, text=True, timeout=60)
+                self.assertNotEqual(result.returncode, 0, result.stdout)
+                self.assertIn("incomplete", result.stderr.lower())
+                self.assertNotIn("Done.", result.stdout)
+                self.assertTrue((real / ".bashrc").exists())
+
+    def test_restore_reports_missing_optional_helpers(self) -> None:
+        archive = self.export()
+        isolated = self.root / "restore-bin"
+        isolated.mkdir()
+        for tool in ("bash", "date", "dirname", "mkdir", "mktemp", "find", "cp", "mv"):
+            (isolated / tool).symlink_to(shutil.which(tool))
+        sudo = isolated / "sudo"
+        sudo.write_text("#!/bin/bash\nexit 0\n")
+        sudo.chmod(0o755)
+        real = self.root / "restore-missing"
+        real.mkdir()
+        with tarfile.open(archive) as tar:
+            tar.extractall(real, filter="fully_trusted")
+        restore = next(real.glob("omarchy-export-*/restore.sh"))
+        result = subprocess.run(["/bin/bash", str(restore)],
+                                env=dict(self.env, HOME=str(real), PATH=str(isolated)),
+                                capture_output=True, text=True, timeout=60)
+        self.assertNotEqual(result.returncode, 0, result.stdout)
+        self.assertIn("yay", result.stderr)
+        self.assertIn("omarchy-theme-set", result.stderr)
+        self.assertNotIn("Done.", result.stdout)
+
+
+    def test_restore_preserves_relative_destination_hypr_link(self) -> None:
+        archive = self.export()
+        real = self.root / "linked-target"
+        (real / ".config").mkdir(parents=True)
+        (real / "dotfiles/hypr").mkdir(parents=True)
+        (real / "dotfiles/hypr/monitors.lua").write_text("native display")
+        (real / ".config/hypr").symlink_to("../dotfiles/hypr")
+        for tool in ("sudo", "yay", "omarchy-theme-set"):
+            self.fake(tool, "exit 0")
+        with tarfile.open(archive) as tar:
+            tar.extractall(real, filter="fully_trusted")
+        restore = next(real.glob("omarchy-export-*/restore.sh"))
+        result = subprocess.run(["bash", str(restore)], env=dict(self.env, HOME=str(real)),
+                                capture_output=True, text=True, timeout=60)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(os.readlink(real / ".config/hypr"), "../dotfiles/hypr")
+        self.assertEqual((real / ".config/hypr/monitors.lua").read_text(), "native display")
+
+    def test_repeated_restores_keep_separate_backups(self) -> None:
+        archive = self.export()
+        real = self.root / "repeated-restore"
+        real.mkdir()
+        for tool in ("sudo", "yay", "omarchy-theme-set"):
+            self.fake(tool, "exit 0")
+        self.fake("date", "echo 20260912-120000")
+        with tarfile.open(archive) as tar:
+            tar.extractall(real, filter="fully_trusted")
+        restore = next(real.glob("omarchy-export-*/restore.sh"))
+        for content in ("original", "later edit"):
+            (real / ".bashrc").write_text(content)
+            result = subprocess.run(["bash", str(restore)], env=dict(self.env, HOME=str(real)),
+                                    capture_output=True, text=True, timeout=60)
+            self.assertEqual(result.returncode, 0, result.stderr)
+        backups = list((real / ".omarchy-restore-backup").iterdir())
+        self.assertEqual(len(backups), 2)
+        self.assertEqual({(backup / ".bashrc").read_text() for backup in backups}, {"original", "later edit"})
+
+
 if __name__ == "__main__":
     unittest.main()
 
 
+
 class HostLocaleTests(OverlayCase):
     def setUp(self) -> None:
         super().setUp()

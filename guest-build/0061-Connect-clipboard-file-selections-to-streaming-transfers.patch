diff --git a/guest/tests/test_file_transfer.py b/guest/tests/test_file_transfer.py
index 6073f64..1825db4 100644
--- a/guest/tests/test_file_transfer.py
+++ b/guest/tests/test_file_transfer.py
@@ -149,3 +149,27 @@ class StreamingFileTests(unittest.TestCase):
             finally:
                 server.shutdown()
                 worker.join()
+
+    def test_clipboard_selection_tracks_edits_and_directory_changes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            source = root / 'source'
+            source.mkdir()
+            child = source / 'file'
+            child.write_text('original')
+            first = transfer.clipboard_selection_key([source])
+            self.assertEqual(first, transfer.clipboard_selection_key([source]))
+            child.write_text('updated contents')
+            second = transfer.clipboard_selection_key([source])
+            self.assertNotEqual(first, second)
+            (source / 'new').write_text('new file')
+            self.assertNotEqual(second, transfer.clipboard_selection_key([source]))
+
+    def test_clipboard_selection_rejects_linked_sources(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            source = root / 'source'
+            source.mkdir()
+            (source / 'link').symlink_to(root / 'outside')
+            with self.assertRaises(ValueError):
+                transfer.clipboard_selection_key([source])

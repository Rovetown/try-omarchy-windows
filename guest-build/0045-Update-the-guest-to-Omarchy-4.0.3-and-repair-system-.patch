index 0000000..baed05a
--- /dev/null
+++ b/guest/factory-overlay/etc/systemd/system/try-omarchy-browser-policy.service
@@ -0,0 +1,13 @@
+[Unit]
+Description=Repair Try Omarchy Chromium theme policy setup
+Before=display-manager.service
+After=local-fs.target
+ConditionPathExists=/usr/share/try-omarchy/omarchy-theme-browser
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/lib/try-omarchy/repair-browser-policy
+RemainAfterExit=yes
+
+[Install]
+WantedBy=multi-user.target
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/repair-browser-policy b/guest/factory-overlay/usr/local/lib/try-omarchy/repair-browser-policy
new file mode 100755
index 0000000..fd7695d
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/repair-browser-policy
@@ -0,0 +1,22 @@
+#!/bin/bash
+# Repair the omitted Chromium setup on older writable guests. Run before SDDM
+# so no desktop process can race the creation of machine policy directories.
+set -euo pipefail
+
+rule=/etc/sudoers.d/omarchy-theme-browser
+source_rule=/usr/share/try-omarchy/omarchy-theme-browser
+[[ -x /usr/bin/omarchy-theme-set-browser-policy ]] || exit 0
+[[ -f /usr/share/omarchy/install/helpers/browser-policy.sh ]] || exit 0
+if [[ ! -e $rule && ! -L $rule ]]; then
+  visudo -cf "$source_rule"
+  install -d -m 0750 -o root -g root /etc/sudoers.d
+  install -m 0440 -o root -g root "$source_rule" "$rule"
+fi
+# The helper hardens ancestors and creates the managed directory, just as the
+# upstream installer does. It preserves existing root-owned policy files.
+export OMARCHY_PATH=/usr/share/omarchy
+source "$OMARCHY_PATH/install/helpers/browser-policy.sh"
+if ! browser_policy_dir_hardened /etc/chromium/policies/managed ||
+   ! browser_policy_parents_hardened /etc/chromium/policies/managed; then
+  browser_policy_setup_dir /etc/chromium/policies/managed
+fi

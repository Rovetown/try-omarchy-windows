diff --git a/guest/tests/test_pack_lock.py b/guest/tests/test_pack_lock.py
new file mode 100644
index 0000000..34a0c7d
--- /dev/null
+++ b/guest/tests/test_pack_lock.py
@@ -0,0 +1,40 @@
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+
+
+class PackLockTests(unittest.TestCase):
+    def test_refuses_regular_and_dangling_lock_without_removing_it(self):
+        for symlink in (False, True):
+            with self.subTest(symlink=symlink), tempfile.TemporaryDirectory() as td:
+                root = Path(td) / 'root'
+                (root / 'boot').mkdir(parents=True)
+                for name in ('vmlinuz-linux', 'initramfs-linux.img'):
+                    (root / 'boot' / name).touch()
+                lock = root / 'var/lib/pacman/db.lck'
+                lock.parent.mkdir(parents=True)
+                if symlink:
+                    lock.symlink_to('absent')
+                else:
+                    lock.write_text('keep')
+                bindir = Path(td) / 'bin'
+                bindir.mkdir()
+                # The rejection must precede all filesystem image operations.
+                for name in ('mke2fs', 'e2fsck', 'zstd'):
+                    command = bindir / name
+                    command.write_text('#!/bin/sh\necho unexpected-image-operation >&2\nexit 99\n')
+                    command.chmod(0o755)
+                result = subprocess.run(['bash', str(GUEST / 'scripts/pack-image.sh'),
+                                         '--root', str(root), '--output', str(Path(td) / 'out')],
+                                        env=dict(os.environ, PATH=f'{bindir}:{os.environ["PATH"]}'),
+                                        capture_output=True, text=True)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn('package database is locked', result.stderr)
+                self.assertNotIn('unexpected-image-operation', result.stderr)
+                self.assertTrue(os.path.lexists(lock))
+                if not symlink:
+                    self.assertEqual(lock.read_text(), 'keep')

diff --git a/guest/build.sh b/guest/build.sh
index edb24fb..3e325cb 100755
--- a/guest/build.sh
+++ b/guest/build.sh
@@ -220,6 +220,19 @@ done
 
 "$guest_dir/scripts/materialize-omarchy.sh" --root "$root" --source "$source_dir" --spec "$spec"
 python3 "$guest_dir/scripts/apply-omarchy-backports.py" --root "$root" --spec "$spec"
+# Parse changed QML after applying backports. A digest proves identity, not
+# valid QML; zero-context patches previously put statements outside handlers.
+while IFS= read -r relative; do
+  arch-chroot "$root" /usr/lib/qt6/bin/qmlformat --ignore-settings \
+    "/usr/share/omarchy/$relative" >/dev/null
+done < <(python3 - "$spec" <<'QML'
+import json, sys
+spec = json.load(open(sys.argv[1]))
+for path in sorted({target["path"] for patch in spec["authenticity"]["backports"] for target in patch["targets"]}):
+    if path.endswith(".qml"):
+        print(path)
+QML
+)
 "$guest_dir/scripts/configure-rootfs.sh" --root "$root" --spec "$spec"
 "$guest_dir/scripts/register-omarchy-runtime.sh" \
   --root "$root" \

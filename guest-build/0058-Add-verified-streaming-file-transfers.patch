+++ b/guest/tests/test_file_transfer.py
@@ -0,0 +1,83 @@
+import hashlib
+import importlib.machinery
+import importlib.util
+import io
+from pathlib import Path
+import tempfile
+import unittest
+
+HELPER = Path(__file__).resolve().parents[1] / 'factory-overlay/usr/local/bin/file-transfer'
+loader = importlib.machinery.SourceFileLoader('file_transfer', str(HELPER))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+transfer = importlib.util.module_from_spec(spec)
+loader.exec_module(transfer)
+
+
+class StreamingFileTests(unittest.TestCase):
+    def test_large_round_trip(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            source = root / 'large 世界.bin'
+            with source.open('wb') as file:
+                file.truncate(80 << 20)
+                file.seek(4096)
+                file.write(b'preserved contents')
+            archive = root / 'transfer.zip'
+            offer = transfer.pack([source], archive)
+            self.assertEqual(offer['fileBytes'], 80 << 20)
+            destination = root / 'Received'
+            with archive.open('rb') as stream:
+                result = transfer.receive(stream, offer, destination)
+            with source.open('rb') as a, Path(result['paths'][0]).open('rb') as b:
+                self.assertEqual(hashlib.file_digest(a, 'sha256').digest(), hashlib.file_digest(b, 'sha256').digest())
+
+    def test_failures_preserve_both_sides(self):
+        for failure in ('corrupt', 'truncated', 'extra', 'metadata', 'existing'):
+            with self.subTest(failure=failure), tempfile.TemporaryDirectory() as tmp:
+                root = Path(tmp)
+                source = root / 'source'
+                source.write_bytes(b'original contents')
+                archive = root / 'transfer.zip'
+                offer = transfer.pack([source], archive)
+                data = archive.read_bytes()
+                destination = root / 'Received'
+                if failure == 'corrupt':
+                    data = b'x' + data[1:]
+                elif failure == 'truncated':
+                    data = data[:-1]
+                elif failure == 'extra':
+                    data += b'x'
+                elif failure == 'metadata':
+                    offer['fileBytes'] += 1
+                else:
+                    destination.mkdir()
+                with self.assertRaises((ValueError, OSError)):
+                    transfer.receive(io.BytesIO(data), offer, destination)
+                self.assertEqual(source.read_bytes(), b'original contents')
+                if destination.exists():
+                    self.assertEqual(list(destination.iterdir()), [])
+                self.assertFalse(any(path.name.startswith('.transfer-in-') for path in root.iterdir()))
+
+    def test_publication_never_replaces_even_an_empty_directory(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            source, destination = root / 'source', root / 'destination'
+            source.mkdir()
+            (source / 'new').write_text('new')
+            destination.mkdir()
+            with self.assertRaises(OSError):
+                transfer.publish(source, destination)
+            self.assertEqual(list(destination.iterdir()), [])
+            self.assertEqual((source / 'new').read_text(), 'new')
+
+    def test_offer_types_and_links(self):
+        self.assertFalse(transfer.valid_offer({'version': True}))
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            source = root / 'source'
+            source.write_text('private')
+            link = root / 'link'
+            link.symlink_to(source)
+            with self.assertRaises(ValueError):
+                transfer.pack([link], root / 'archive.zip')
+            self.assertFalse((root / 'archive.zip').exists())

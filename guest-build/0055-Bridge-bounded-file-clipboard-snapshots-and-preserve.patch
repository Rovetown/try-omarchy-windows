diff --git a/guest/tests/test_clipboard_files.py b/guest/tests/test_clipboard_files.py
new file mode 100644
index 0000000..942ade5
--- /dev/null
+++ b/guest/tests/test_clipboard_files.py
@@ -0,0 +1,84 @@
+import importlib.machinery
+import io
+import os
+from pathlib import Path
+import tempfile
+import unittest
+import zipfile
+import zlib
+
+HELPER = Path(__file__).resolve().parents[1] / 'factory-overlay/usr/local/bin/clipboard-files'
+files = importlib.machinery.SourceFileLoader('clipboard_files', str(HELPER)).load_module()
+
+class FileClipboardTests(unittest.TestCase):
+    def test_roundtrip_and_cut_preserves_source(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            source = root / 'hello 世界.txt'
+            source.write_bytes(b'hello\0binary')
+            data = files.pack(('cut\n' + source.as_uri() + '\n').encode())
+            uris = files.unpack(data, root / 'cache')
+            result = files.uri_paths(uris)[0]
+            self.assertEqual(result.read_bytes(), source.read_bytes())
+            self.assertTrue(source.exists())
+            files.discard(uris, root / 'cache')
+            self.assertFalse(result.exists())
+            self.assertTrue(source.exists())
+
+    def test_reject_names_and_collisions(self):
+        for names in [['../file'], ['NUL.txt'], ['x:stream'], ['A/x', 'a/y'], ['a','a/x'], ['same', 'same']]:
+            with self.subTest(names=names):
+                data = io.BytesIO()
+                with zipfile.ZipFile(data, 'w') as archive:
+                    for name in names:
+                        archive.writestr(name, b'hello')
+                with self.assertRaises(ValueError):
+                    files.inspect(data.getvalue())
+
+    def test_links_are_not_followed(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            (root/'original').write_text('secret')
+            (root/'link').symlink_to(root/'original')
+            with self.assertRaises(ValueError):
+                files.pack(((root/'link').as_uri()+'\n').encode())
+
+    def test_remote_uris_rejected(self):
+        for uri in [b'file://server/share/file', b'https://example.com/file', b'file:///tmp/file%00suffix', b'']:
+            with self.assertRaises(ValueError):
+                files.uri_paths(uri)
+
+    def test_corruption_removes_staging(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp); source=root/'file';source.write_text('hello')
+            data=bytearray(files.pack((source.as_uri()+'\n').encode()))
+            with zipfile.ZipFile(io.BytesIO(data)) as archive:
+                entry=archive.infolist()[0]
+                pos=entry.header_offset+30+len(entry.filename.encode())+len(entry.extra)
+            data[pos] ^= 255
+            with self.assertRaises((zipfile.BadZipFile, ValueError, zlib.error)):
+                files.unpack(data, root/'cache')
+            self.assertEqual(list((root/'cache').iterdir()), [])
+
+    def test_bridge_suppresses_echo_and_cleans_failed_publish(self):
+        import subprocess
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp); bindir=root/'bin';bindir.mkdir()
+            (bindir/'clipboard-files').symlink_to(HELPER)
+            capture=root/'clipboard'
+            copy=bindir/'wl-copy';copy.write_text('#!/bin/sh\ncat > "$CAPTURE"\n');copy.chmod(0o755)
+            source=root/'source';source.write_text('hello')
+            payload=files.pack((source.as_uri()+'\n').encode())
+            env=dict(os.environ, HOME=str(root), XDG_RUNTIME_DIR=str(root/'runtime'), CAPTURE=str(capture), PATH=str(bindir)+os.pathsep+os.environ['PATH'])
+            bridge=HELPER.with_name('clipboard-bridge')
+            received=subprocess.run(['sh',str(bridge),'--receive-files'],input=payload,env=env,capture_output=True)
+            self.assertEqual(received.returncode,0,received.stderr)
+            uris=capture.read_bytes()
+            push=subprocess.run(['sh',str(bridge),'--push-files'],input=uris,env=env,capture_output=True)
+            self.assertEqual(push.returncode,0,push.stderr)  # no socat required for an echo
+            cache=root/'.cache/try-omarchy/clipboard-files'
+            before=set(cache.iterdir())
+            copy.write_text('#!/bin/sh\nexit 1\n')
+            received=subprocess.run(['sh',str(bridge),'--receive-files'],input=payload,env=env,capture_output=True)
+            self.assertNotEqual(received.returncode,0)
+            self.assertEqual(set(cache.iterdir()),before)

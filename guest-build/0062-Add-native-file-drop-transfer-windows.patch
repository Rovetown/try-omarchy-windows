@@ -0,0 +1,52 @@
+import importlib.machinery
+import importlib.util
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+
+@unittest.skipUnless(os.environ.get('TRYOMARCHY_GTK_TEST') == '1', 'native GTK desktop required')
+class FileTransferWindowTests(unittest.TestCase):
+    def test_native_drag_formats_and_drop_preserve_source(self):
+        helper = Path(__file__).resolve().parents[1] / 'factory-overlay/usr/local/bin/file-transfer-window'
+        loader = importlib.machinery.SourceFileLoader('file_transfer_window', str(helper))
+        spec = importlib.util.spec_from_loader(loader.name, loader)
+        module = importlib.util.module_from_spec(spec)
+        loader.exec_module(module)
+        with tempfile.TemporaryDirectory() as tmp, patch.dict(os.environ, XDG_CACHE_HOME=tmp):
+            app = module.Transfers()
+            app.set_application_id('org.omarchy.FileTransfers.Test')
+            app.state = Path(tmp) / 'state'
+            app.state.mkdir()
+            app.register(None)
+            app.activate()
+            try:
+                path = Path(tmp) / 'dragged 世界.txt'
+                path.write_text('preserved')
+                app.add_received(str(path))
+                row = app.list.get_row_at_index(0)
+                controllers = row.observe_controllers()
+                sources = [controllers.get_item(i) for i in range(controllers.get_n_items())
+                           if isinstance(controllers.get_item(i), module.Gtk.DragSource)]
+                self.assertEqual(len(sources), 1)
+                provider = sources[0].emit('prepare', 0.0, 0.0)
+                self.assertTrue(provider.ref_formats().contain_gtype(module.Gdk.FileList))
+                with patch.object(app, 'start') as start:
+                    self.assertTrue(app.drop(None, module.Gdk.FileList.new_from_list(
+                        [module.Gio.File.new_for_path(str(path))]), 0, 0))
+                    self.assertEqual(start.call_args.args[0][1], 'drop-send')
+                    self.assertIn(path.as_uri().encode(), start.call_args.args[1])
+                self.assertEqual(path.read_text(), 'preserved')
+                with patch.object(module.subprocess, 'Popen', side_effect=FileNotFoundError('helper missing')), \
+                     patch.object(module.GLib, 'idle_add') as idle:
+                    ticket = app.state / 'incoming-drop-test'
+                    ticket.write_text('{}')
+                    app.start(['missing'], ticket=ticket)
+                    self.assertFalse(ticket.exists())
+                    self.assertIsNone(app.worker)
+                    idle.assert_called_once_with(app.next_download)
+            finally:
+                app.window.destroy()
+                app.quit()

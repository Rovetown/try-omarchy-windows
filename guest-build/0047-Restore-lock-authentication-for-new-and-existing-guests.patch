diff --git a/guest/tests/test_lock_pam.py b/guest/tests/test_lock_pam.py
new file mode 100644
index 0000000..cd3376c
--- /dev/null
+++ b/guest/tests/test_lock_pam.py
@@ -0,0 +1,71 @@
+import importlib.machinery
+import importlib.util
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'factory-overlay/usr/local/lib/try-omarchy/repair-lock-pam'
+loader = importlib.machinery.SourceFileLoader('lock_pam', str(SCRIPT))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+module = importlib.util.module_from_spec(spec)
+loader.exec_module(module)
+
+
+class LockPamTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.parent = self.root / 'etc/pam.d'
+        self.parent.mkdir(parents=True)
+        self.target = self.parent / 'omarchy-lock-password'
+
+    def test_missing_profile_installed_completely_and_idempotently(self):
+        contents = b'#%PAM-1.0\nauth required pam_unix.so\n'
+        self.assertTrue(module.repair(self.root, contents))
+        self.assertEqual(self.target.read_bytes(), contents)
+        self.assertEqual(self.target.stat().st_mode & 0o777, 0o644)
+        self.assertFalse(module.repair(self.root, b'replacement'))
+        self.assertEqual(self.target.read_bytes(), contents)
+        self.assertEqual(list(self.parent.iterdir()), [self.target])
+
+    def test_custom_profile_preserved(self):
+        self.target.write_text('custom policy')
+        self.target.chmod(0o600)
+        self.assertFalse(module.repair(self.root, b'replacement'))
+        self.assertEqual(self.target.read_text(), 'custom policy')
+        self.assertEqual(self.target.stat().st_mode & 0o777, 0o600)
+
+    def test_symlink_profile_is_not_followed_or_replaced(self):
+        outside = self.root / 'outside'
+        self.target.symlink_to(outside)
+        self.assertFalse(module.repair(self.root, b'replacement'))
+        self.assertTrue(self.target.is_symlink())
+        self.assertFalse(outside.exists())
+
+    def test_redirected_directory_rejected(self):
+        self.parent.rmdir()
+        outside = self.root / 'outside'
+        outside.mkdir()
+        self.parent.symlink_to(outside)
+        with self.assertRaises(OSError):
+            module.repair(self.root, b'replacement')
+        self.assertEqual(list(outside.iterdir()), [])
+
+    def test_writable_parent_rejected(self):
+        self.parent.chmod(0o777)
+        with self.assertRaises(PermissionError):
+            module.repair(self.root, b'replacement')
+        self.assertFalse(self.target.exists())
+
+    def test_concurrent_profile_creation_preserved(self):
+        link = os.link
+        def competing_writer(*args, **kwargs):
+            self.target.write_text('administrator policy')
+            return link(*args, **kwargs)
+        with patch.object(module.os, 'link', side_effect=competing_writer):
+            self.assertFalse(module.repair(self.root, b'replacement'))
+        self.assertEqual(self.target.read_text(), 'administrator policy')
+        self.assertEqual(list(self.parent.iterdir()), [self.target])

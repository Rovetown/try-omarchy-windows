index 0000000..99ab012
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/repair-lock-pam
@@ -0,0 +1,49 @@
+#!/usr/bin/python3
+"""Supply the omitted lock PAM profile without replacing local configuration."""
+import os
+from pathlib import Path
+import secrets
+import stat
+
+
+def repair(root, contents):
+    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+    directory = os.open(root, flags)
+    try:
+        for part in ("etc", "pam.d"):
+            child = os.open(part, flags, dir_fd=directory)
+            os.close(directory)
+            directory = child
+            info = os.fstat(directory)
+            if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) & 0o022:
+                raise PermissionError("refusing writable or foreign-owned PAM directory")
+        name = "omarchy-lock-password"
+        try:
+            os.stat(name, dir_fd=directory, follow_symlinks=False)
+            return False
+        except FileNotFoundError:
+            pass
+        temporary = ".try-omarchy-lock-" + secrets.token_hex(16)
+        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
+                     0o600, dir_fd=directory)
+        try:
+            with os.fdopen(fd, "wb") as output:
+                output.write(contents)
+                output.flush()
+                os.fchmod(output.fileno(), 0o644)
+                os.fsync(output.fileno())
+            try:
+                os.link(temporary, name, src_dir_fd=directory, dst_dir_fd=directory,
+                        follow_symlinks=False)
+            except FileExistsError:
+                return False
+            os.fsync(directory)
+            return True
+        finally:
+            os.unlink(temporary, dir_fd=directory)
+    finally:
+        os.close(directory)
+
+
+if __name__ == "__main__":
+    repair("/", Path("/usr/share/try-omarchy/omarchy-lock-password").read_bytes())

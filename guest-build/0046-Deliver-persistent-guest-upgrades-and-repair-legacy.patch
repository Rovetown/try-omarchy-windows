+import importlib.machinery
+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'factory-overlay/usr/local/lib/try-omarchy/repair-icon-names'
+loader = importlib.machinery.SourceFileLoader('icons', str(SCRIPT))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+module = importlib.util.module_from_spec(spec)
+loader.exec_module(module)
+
+
+class IconNamesTests(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.root = Path(tmp.name)
+        self.source = self.root / 'reference'
+        self.icons = self.root / 'icons'
+        self.source.mkdir()
+        self.icons.mkdir()
+        (self.source / 'Google Maps.png').write_bytes(b'original image')
+        self.old = self.icons / 'Google Maps.png'
+        self.new = self.icons / 'google-maps.png'
+        self.old.write_bytes(b'original image')
+
+    def test_unchanged_icon_is_renamed_and_retry_is_harmless(self):
+        module.repair(self.source, self.icons)
+        module.repair(self.source, self.icons)
+        self.assertFalse(self.old.exists())
+        self.assertEqual(self.new.read_bytes(), b'original image')
+
+    def test_custom_icon_is_preserved(self):
+        self.old.write_bytes(b'my image')
+        module.repair(self.source, self.icons)
+        self.assertEqual(self.old.read_bytes(), b'my image')
+        self.assertFalse(self.new.exists())
+
+    def test_existing_target_is_preserved(self):
+        self.new.write_bytes(b'existing image')
+        module.repair(self.source, self.icons)
+        self.assertTrue(self.old.exists())
+        self.assertEqual(self.new.read_bytes(), b'existing image')
+
+    def test_redirected_directory_is_rejected(self):
+        alias = self.root / 'alias'
+        alias.symlink_to(self.icons, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            module.repair(self.source, alias)
+        self.assertTrue(self.old.exists())

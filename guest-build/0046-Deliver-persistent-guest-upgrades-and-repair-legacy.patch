+#!/usr/bin/env python3
+"""Normalize unchanged image icons to the names used by upstream desktop files."""
+import hashlib
+from pathlib import Path
+import stat
+
+
+def real_directory(path):
+    return all(stat.S_ISDIR(p.lstat().st_mode) for p in (path, *path.parents))
+
+
+def repair(reference, icons):
+    if not real_directory(reference) or not real_directory(icons):
+        raise ValueError('icon paths must be real directories')
+    for original in reference.iterdir():
+        name = original.name.lower().replace(' ', '-')
+        if name == original.name or not stat.S_ISREG(original.lstat().st_mode):
+            continue
+        old, new = icons / original.name, icons / name
+        if not old.exists() or not stat.S_ISREG(old.lstat().st_mode):
+            continue
+        # Only relocate the exact source image. Administrator replacements and
+        # an existing target are left untouched for manual review.
+        if new.exists() or new.is_symlink():
+            continue
+        if hashlib.sha256(old.read_bytes()).digest() != hashlib.sha256(original.read_bytes()).digest():
+            continue
+        old.rename(new)
+        print(f'Renamed image icon: {old.name} -> {new.name}')
+
+
+if __name__ == '__main__':
+    repair(Path('/usr/share/omarchy/applications/icons'),
+           Path('/usr/share/icons/hicolor/256x256/apps'))
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/repair-system-ownership b/guest/factory-overlay/usr/local/lib/try-omarchy/repair-system-ownership

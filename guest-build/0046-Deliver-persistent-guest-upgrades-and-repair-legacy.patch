new file mode 100755
index 0000000..c4428c1
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/publish-update-repository
@@ -0,0 +1,136 @@
+#!/usr/bin/env python3
+"""Publish the image's verified local packages without changing installed packages."""
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import stat
+import subprocess
+import tarfile
+import tempfile
+
+DATABASE = 'try-omarchy.db.tar.gz'
+
+
+def regular(path):
+    if not stat.S_ISREG(path.lstat().st_mode):
+        raise ValueError(f'not a regular file: {path}')
+
+
+def trusted_directory(path):
+    for parent in [path, *path.parents]:
+        if not stat.S_ISDIR(parent.lstat().st_mode):
+            raise ValueError(f'not a real directory: {parent}')
+
+
+def digest(path):
+    with path.open('rb') as stream:
+        return hashlib.file_digest(stream, 'sha256').hexdigest()
+
+
+def runtime_version(database):
+    regular(database)
+    with tarfile.open(database, 'r:gz') as archive:
+        versions = []
+        for entry in archive:
+            if not entry.isfile() or not entry.name.endswith('/desc'):
+                continue
+            if entry.size > 65536:
+                raise ValueError('oversized repository metadata')
+            data = archive.extractfile(entry).read().decode().splitlines()
+            fields = {data[i]: data[i + 1] for i in range(len(data) - 1)
+                      if data[i].startswith('%')}
+            if fields.get('%NAME%') == 'try-omarchy-runtime':
+                versions.append(fields.get('%VERSION%', ''))
+        if len(versions) != 1 or not versions[0]:
+            raise ValueError('repository must contain one Omarchy runtime')
+        return versions[0]
+
+
+def atomic_copy(source, destination):
+    # Files and package archives are durable before the database points at them.
+    fd, temporary = tempfile.mkstemp(prefix='.publish-', dir=destination.parent)
+    try:
+        with os.fdopen(fd, 'wb') as output, source.open('rb') as input_file:
+            shutil.copyfileobj(input_file, output)
+            output.flush()
+            os.fchmod(output.fileno(), 0o644)
+            os.fsync(output.fileno())
+        os.replace(temporary, destination)
+        directory = os.open(destination.parent, os.O_DIRECTORY | os.O_RDONLY)
+        try:
+            os.fsync(directory)
+        finally:
+            os.close(directory)
+    finally:
+        if os.path.lexists(temporary):
+            os.unlink(temporary)
+
+
+def publish(source, destination):
+    trusted_directory(source)
+    trusted_directory(destination)
+    manifest_file = source / 'manifest.json'
+    regular(manifest_file)
+    if manifest_file.stat().st_size > 65536:
+        raise ValueError('oversized update manifest')
+    manifest = json.loads(manifest_file.read_text())
+    files = manifest.get('files', {})
+    if manifest.get('schema') != 1 or not isinstance(files, dict) or DATABASE not in files:
+        raise ValueError('invalid update manifest')
+    if not 2 <= len(files) <= 10:
+        raise ValueError('invalid update file count')
+    for name, expected in files.items():
+        if (Path(name).name != name or name.startswith('.') or
+                not (name == DATABASE or name.endswith('.pkg.tar.zst'))):
+            raise ValueError('unsafe update filename')
+        candidate = source / name
+        regular(candidate)
+        if candidate.stat().st_size != expected['size'] or digest(candidate) != expected['sha256']:
+            raise ValueError(f'incomplete or corrupt update payload: {name}')
+    offered = runtime_version(source / DATABASE)
+    if offered != manifest.get('runtimeVersion'):
+        raise ValueError('runtime version differs from manifest')
+    database = destination / DATABASE
+    if os.path.lexists(database):
+        current = runtime_version(database)
+        order = int(subprocess.check_output(['vercmp', offered, current], text=True).strip())
+        if order < 0:
+            print(f'Keeping newer Omarchy repository {current}')
+            return
+        if order == 0 and digest(database) != files[DATABASE]['sha256']:
+            raise ValueError('different repositories use the same runtime version')
+    alias = destination / 'try-omarchy.db'
+    if not alias.is_symlink() or os.readlink(alias) != DATABASE:
+        raise ValueError('local repository database link was changed')
+    # Validate every existing path before any write. Never replace an archive
+    # with different bytes under the same filename, or follow a planted link.
+    for name, expected in files.items():
+        target = destination / name
+        if os.path.lexists(target):
+            regular(target)
+            if name != DATABASE and digest(target) != expected['sha256']:
+                raise ValueError(f'existing package differs: {name}')
+    for name in sorted(files):
+        if name != DATABASE and not (destination / name).exists():
+            atomic_copy(source / name, destination / name)
+    # Old archives are deliberately retained. A pacman process that read the
+    # old database can finish, and interruption before this rename is harmless.
+    if not database.exists() or digest(database) != files[DATABASE]['sha256']:
+        atomic_copy(source / DATABASE, database)
+    print(f'Omarchy {offered} is available through Update > Omarchy')
+
+
+def main():
+    if os.geteuid() != 0:
+        raise SystemExit('Run this helper as root')
+    with open('/run/try-omarchy-update-repository.lock', 'w') as guard:
+        fcntl.flock(guard, fcntl.LOCK_EX)
+        publish(Path('/usr/share/try-omarchy/update-repository'),
+                Path('/usr/share/try-omarchy/repo'))
+
+
+if __name__ == '__main__':
+    main()

index 0000000..145f88e
--- /dev/null
+++ b/guest/tests/test_system_ownership.py
@@ -0,0 +1,44 @@
+import importlib.machinery
+import importlib.util
+import os
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'factory-overlay/usr/local/lib/try-omarchy/repair-system-ownership'
+loader = importlib.machinery.SourceFileLoader('ownership', str(SCRIPT))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+module = importlib.util.module_from_spec(spec)
+loader.exec_module(module)
+
+
+class SystemOwnershipTests(unittest.TestCase):
+    def test_only_named_paths_are_repaired(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.object(module.os, 'chown') as chown:
+            root = Path(tmp)
+            (root / 'etc').mkdir()
+            (root / 'etc/managed').write_text('keep contents')
+            (root / 'etc/custom').write_text('keep ownership')
+            module.repair(root, ['/etc/managed'])
+            self.assertEqual(chown.call_count, int(os.getuid() != 0 or os.getgid() != 0))
+            if chown.called:
+                self.assertEqual(chown.call_args.args, ('managed', 0, 0))
+                self.assertFalse(chown.call_args.kwargs['follow_symlinks'])
+            self.assertEqual((root / 'etc/managed').read_text(), 'keep contents')
+
+    def test_redirected_parent_is_not_followed(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.object(module.os, 'chown') as chown:
+            root = Path(tmp)
+            (root / 'outside').mkdir()
+            (root / 'outside/file').write_text('untouched')
+            (root / 'etc').symlink_to(root / 'outside', target_is_directory=True)
+            module.repair(root, ['/etc/file'])
+            chown.assert_not_called()
+
+    def test_unsafe_paths_fail_before_any_change(self):
+        for bad in ('/home/user/file', '/etc/../home/file', 'etc/file'):
+            with self.subTest(bad=bad), patch.object(module.os, 'open') as opened:
+                with self.assertRaises(ValueError):
+                    module.repair('/', ['/etc', bad])
+                opened.assert_not_called()
diff --git a/guest/tests/test_update_repository.py b/guest/tests/test_update_repository.py
new file mode 100644
index 0000000..6a6154b
--- /dev/null
+++ b/guest/tests/test_update_repository.py
@@ -0,0 +1,143 @@
+import hashlib
+import importlib.machinery
+import importlib.util
+import io
+import json
+from pathlib import Path
+import tarfile
+import tempfile
+import unittest
+from unittest.mock import patch
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'factory-overlay/usr/local/lib/try-omarchy/publish-update-repository'
+loader = importlib.machinery.SourceFileLoader('update_repo', str(SCRIPT))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+module = importlib.util.module_from_spec(spec)
+loader.exec_module(module)
+
+
+def database(path, version):
+    content = f'%NAME%\ntry-omarchy-runtime\n\n%VERSION%\n{version}\n'.encode()
+    with tarfile.open(path, 'w:gz') as archive:
+        entry = tarfile.TarInfo(f'try-omarchy-runtime-{version}/desc')
+        entry.size = len(content)
+        archive.addfile(entry, io.BytesIO(content))
+
+
+class UpdateRepositoryTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.source = self.root / 'source'
+        self.target = self.root / 'target'
+        self.source.mkdir()
+        self.target.mkdir()
+        self.old = self.target / 'try-omarchy-runtime-4.0.2-1-any.pkg.tar.zst'
+        self.old.write_bytes(b'old package')
+        database(self.target / module.DATABASE, '4.0.2-1')
+        (self.target / 'try-omarchy.db').symlink_to(module.DATABASE)
+        self.package = 'try-omarchy-runtime-4.0.3-2-any.pkg.tar.zst'
+        (self.source / self.package).write_bytes(b'new package')
+        database(self.source / module.DATABASE, '4.0.3-2')
+        self.manifest()
+        # No system package manager is involved in these publication tests.
+        self.comparator = patch.object(module.subprocess, 'check_output', return_value='1\n')
+        self.comparator.start()
+        self.addCleanup(self.comparator.stop)
+
+    def manifest(self):
+        files = {p.name: {'size': p.stat().st_size,
+                         'sha256': hashlib.sha256(p.read_bytes()).hexdigest()}
+                 for p in self.source.iterdir() if p.name != 'manifest.json'}
+        (self.source / 'manifest.json').write_text(json.dumps({
+            'schema': 1, 'runtimeVersion': '4.0.3-2', 'files': files}))
+
+    def publish(self):
+        module.publish(self.source, self.target)
+
+    def test_publishes_and_retains_old_archives(self):
+        self.publish()
+        self.assertEqual(module.runtime_version(self.target / module.DATABASE), '4.0.3-2')
+        self.assertEqual(self.old.read_bytes(), b'old package')
+        self.assertEqual((self.target / self.package).read_bytes(), b'new package')
+        self.assertEqual(list(self.target.glob('.publish-*')), [])
+
+    def test_interruption_before_database_keeps_old_repository_and_retry_finishes(self):
+        real_copy = module.atomic_copy
+        def fail_database(source, target):
+            if target.name == module.DATABASE:
+                raise OSError('simulated interruption')
+            real_copy(source, target)
+        with patch.object(module, 'atomic_copy', side_effect=fail_database):
+            with self.assertRaises(OSError):
+                self.publish()
+        self.assertEqual(module.runtime_version(self.target / module.DATABASE), '4.0.2-1')
+        self.assertTrue((self.target / self.package).exists())
+        self.publish()
+        self.assertEqual(module.runtime_version(self.target / module.DATABASE), '4.0.3-2')
+
+    def test_corrupt_payload_publishes_nothing(self):
+        before = (self.target / module.DATABASE).read_bytes()
+        (self.source / self.package).write_bytes(b'corrupted')
+        with self.assertRaises(ValueError):
+            self.publish()
+        self.assertFalse((self.target / self.package).exists())
+        self.assertEqual((self.target / module.DATABASE).read_bytes(), before)
+
+    def test_rejects_downgrade(self):
+        with patch.object(module.subprocess, 'check_output', return_value='-1\n'):
+            self.publish()
+        self.assertEqual(module.runtime_version(self.target / module.DATABASE), '4.0.2-1')
+        self.assertFalse((self.target / self.package).exists())
+
+    def test_same_version_different_database_is_not_republished(self):
+        with patch.object(module.subprocess, 'check_output', return_value='0\n'):
+            with self.assertRaises(ValueError):
+                self.publish()
+
+    def test_repeated_publication_is_idempotent(self):
+        self.publish()
+        with patch.object(module.subprocess, 'check_output', return_value='0\n'), \
+             patch.object(module, 'atomic_copy', side_effect=AssertionError('unexpected write')):
+            self.publish()
+
+    def test_preserves_modified_archive_and_database(self):
+        (self.target / self.package).write_bytes(b'custom')
+        with self.assertRaises(ValueError):
+            self.publish()
+        self.assertEqual((self.target / self.package).read_bytes(), b'custom')
+        self.assertEqual(module.runtime_version(self.target / module.DATABASE), '4.0.2-1')
+
+    def test_rejects_destination_symlink(self):
+        outside = self.root / 'outside'
+        outside.write_bytes(b'keep')
+        (self.target / self.package).symlink_to(outside)
+        with self.assertRaises(ValueError):
+            self.publish()
+        self.assertEqual(outside.read_bytes(), b'keep')
+
+    def test_rejects_changed_database_alias(self):
+        (self.target / 'try-omarchy.db').unlink()
+        (self.target / 'try-omarchy.db').symlink_to('custom.db')
+        with self.assertRaises(ValueError):
+            self.publish()
+
+    def test_atomic_copy_failure_keeps_destination_and_cleans_temporary(self):
+        before = (self.target / module.DATABASE).read_bytes()
+        with patch.object(module.os, 'replace', side_effect=OSError('rename failed')):
+            with self.assertRaises(OSError):
+                module.atomic_copy(self.source / module.DATABASE, self.target / module.DATABASE)
+        self.assertEqual((self.target / module.DATABASE).read_bytes(), before)
+        self.assertEqual(list(self.target.glob('.publish-*')), [])
+
+    def test_rejects_path_traversal(self):
+        manifest = json.loads((self.source / 'manifest.json').read_text())
+        manifest['files']['../outside.pkg.tar.zst'] = manifest['files'][self.package]
+        (self.source / 'manifest.json').write_text(json.dumps(manifest))
+        with self.assertRaises(ValueError):
+            self.publish()
+
+
+if __name__ == '__main__':
+    unittest.main()

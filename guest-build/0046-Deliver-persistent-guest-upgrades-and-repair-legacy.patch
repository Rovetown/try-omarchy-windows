+for overlay in (guest / 'factory-overlay', guest / 'native-overlay'):
+    paths.update('/' + str(p.relative_to(overlay)) for p in overlay.rglob('*'))
+(root / 'usr/share/try-omarchy/system-owned-paths').write_text('\n'.join(sorted(paths)) + '\n')

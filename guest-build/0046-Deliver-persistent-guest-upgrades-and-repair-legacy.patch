@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Repair builder-owned overlay paths without following guest symlinks."""
+import os
+from pathlib import Path, PurePosixPath
+
+
+def repair(root, paths):
+    for name in paths:
+        path = PurePosixPath(name)
+        if not path.is_absolute() or '..' in path.parts or (name != '/' and path.parts[1] not in ('etc', 'usr')):
+            raise ValueError(f'unsafe managed system path: {name}')
+    for name in paths:
+        parts = PurePosixPath(name).parts[1:]
+        fd = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+        try:
+            if not parts:
+                info = os.fstat(fd)
+                if info.st_uid or info.st_gid:
+                    os.fchown(fd, 0, 0)
+                continue
+            try:
+                for part in parts[:-1]:
+                    child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
+                    os.close(fd)
+                    fd = child
+                info = os.stat(parts[-1], dir_fd=fd, follow_symlinks=False)
+                if info.st_uid or info.st_gid:
+                    os.chown(parts[-1], 0, 0, dir_fd=fd, follow_symlinks=False)
+            except (FileNotFoundError, NotADirectoryError):
+                # Missing or redirected managed paths are not permission repairs.
+                continue
+        finally:
+            os.close(fd)
+
+
+if __name__ == '__main__':
+    paths = Path('/usr/share/try-omarchy/system-owned-paths').read_text().splitlines()
+    repair('/', paths)

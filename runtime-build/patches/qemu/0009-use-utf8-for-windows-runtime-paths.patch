 #ifdef __FreeBSD__
 #include <sys/sysctl.h>
@@ -1050,6 +1051,16 @@
     char buf[MAX_PATH];
     DWORD len;
 
+    /* QEMU filenames are UTF-8. The UCRT otherwise interprets fopen/access
+     * paths using the legacy code page, even with a UTF-8 Windows manifest.
+     * This runs before option parsing in both the emulator and qemu-img.
+     * Leave numeric parsing and formatting in the C locale.
+     */
+    if (!setlocale(LC_CTYPE, ".UTF8")) {
+        fprintf(stderr, "QEMU requires UTF-8 support in the Windows UCRT\n");
+        exit(EXIT_FAILURE);
+    }
+
     if (exec_dir) {
         return;
     }

+#ifndef UTIME_NOW
+#define UTIME_NOW ((1L << 30) - 1L)
+#define UTIME_OMIT ((1L << 30) - 2L)
+#endif
+
+static HANDLE create_file_utf8(const char *path, DWORD access, DWORD sharing,
+                               LPSECURITY_ATTRIBUTES security, DWORD creation,
+                               DWORD flags, HANDLE template)
+{
+    g_autofree gunichar2 *wide = g_utf8_to_utf16(path, -1, NULL, NULL, NULL);
+    if (!wide) {
+        SetLastError(ERROR_NO_UNICODE_TRANSLATION);
+        return INVALID_HANDLE_VALUE;
+    }
+    return CreateFileW((WCHAR *)wide, access, sharing, security, creation,
+                       flags, template);
+}
+
+static DWORD file_attributes_utf8(const char *path)
+{
+    g_autofree gunichar2 *wide = g_utf8_to_utf16(path, -1, NULL, NULL, NULL);
+    if (!wide) {
+        SetLastError(ERROR_NO_UNICODE_TRANSLATION);
+        return INVALID_FILE_ATTRIBUTES;
+    }
+    return GetFileAttributesW((WCHAR *)wide);
+}
+
+static BOOL delete_file_utf8(const char *path)
+{
+    g_autofree gunichar2 *wide = g_utf8_to_utf16(path, -1, NULL, NULL, NULL);
+    if (!wide) {
+        SetLastError(ERROR_NO_UNICODE_TRANSLATION);
+        return FALSE;
+    }
+    return DeleteFileW((WCHAR *)wide);
+}
+
+/* GStatBuf and struct stat need not have the same Windows CRT layout. */
+static int stat_utf8(const char *path, struct stat *st)
+{
+    GStatBuf wide;
+    int ret = g_stat(path, &wide);
+    if (ret == 0) {
+        st->st_dev = wide.st_dev;
+        st->st_ino = wide.st_ino;
+        st->st_mode = wide.st_mode;
+        st->st_nlink = wide.st_nlink;
+        st->st_uid = wide.st_uid;
+        st->st_gid = wide.st_gid;
+        st->st_rdev = wide.st_rdev;
+        st->st_size = wide.st_size;
+        st->st_atime = wide.st_atime;
+        st->st_mtime = wide.st_mtime;
+        st->st_ctime = wide.st_ctime;
+    }
+    return ret;
+}
+
+/* NULL FILETIME means preserve; special POSIX nanoseconds are not a date. */
+static int set_times_win32(HANDLE file, const struct timespec times[2])
+{
+    FILETIME now, values[2];
+    const FILETIME *pointers[2] = { NULL, NULL };
+    const int64_t epoch = 116444736000000000LL;
+
+    GetSystemTimeAsFileTime(&now);
+    for (int i = 0; i < 2; i++) {
+        if (!times || times[i].tv_nsec == UTIME_NOW) {
+            values[i] = now;
+        } else if (times[i].tv_nsec == UTIME_OMIT) {
+            continue;
+        } else {
+            ULARGE_INTEGER value;
+            if (times[i].tv_nsec < 0 || times[i].tv_nsec >= 1000000000L ||
+                times[i].tv_sec < -11644473600LL ||
+                times[i].tv_sec > (INT64_MAX - epoch - 9999999) / 10000000) {
+                errno = EINVAL;
+                return -1;
+            }
+            value.QuadPart = times[i].tv_sec * 10000000LL + epoch +
+                             times[i].tv_nsec / 100;
+            values[i].dwLowDateTime = value.LowPart;
+            values[i].dwHighDateTime = value.HighPart;
+        }
+        pointers[i] = &values[i];
+    }
+    if (!SetFileTime(file, NULL, pointers[0], pointers[1])) {
+        errno = win32_error_to_posix(GetLastError());
+        return -1;
+    }
+    return 0;
+}
